# ==============================================================================
# CastorPay Environment Configuration
# ==============================================================================

# Core Application
PROJECT_NAME="CastorPay"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="castor-secret-key-change-in-production-32-chars-min"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=castor_user
POSTGRES_PASSWORD=castor_password
POSTGRES_DB=castor_db
DATABASE_URL="postgresql+asyncpg://castor_user:castor_password@postgres:5432/castor_db"
SYNC_DATABASE_URL="postgresql://castor_user:castor_password@postgres:5432/castor_db"

# Redis Cache & Distributed Locking
REDIS_URL="redis://redis:6379/0"
IDEMPOTENCY_TTL_SECONDS=86400
FX_QUOTE_LOCK_SECONDS=60

# AWS & LocalStack Messaging
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
AWS_ENDPOINT_URL="http://localstack:4566"
SQS_PAYMENT_QUEUE_NAME="castor-payment-events"
SQS_PAYMENT_QUEUE_URL="http://localstack:4566/000000000000/castor-payment-events"
SQS_DLQ_NAME="castor-payment-events-dlq"
SQS_DLQ_URL="http://localstack:4566/000000000000/castor-payment-events-dlq"

# Webhooks & Security
WEBHOOK_HMAC_SECRET="castor_whsec_dev_982347198273"
WEBHOOK_MAX_RETRIES=5

# Payment Providers (Sandbox / Keys)
PAYSTACK_SECRET_KEY="sk_test_mock_paystack"
FLUTTERWAVE_SECRET_KEY="flw_sec_test_mock"
STRIPE_SECRET_KEY="sk_test_mock_stripe"

# Mock Rail & Chaos Simulator Settings
MOCK_PROVIDER_ENABLED=true
CHAOS_FAILURE_RATE=0.0
CHAOS_LATENCY_MS=100

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000/api/v1"
